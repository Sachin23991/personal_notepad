# Copy to .env for local tooling (never commit real keys).
# Browsers cannot read .env — paste the key in NoteFlow Settings → AI,
# or use config.local.js (see config.local.js.example).

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NOTEFLOW_AI_SYSTEM_PROMPT=You are NoteFlow AI. Help edit and teach clearly.
